# Copy this file to .env and fill it in before starting the stack.
# .env is gitignored. Docker Compose reads it from the project directory.

# Initial password for the GitLab root user.
# Applied only on the first boot of the gitlab service.
# Leave it empty to let GitLab generate a password and store it in
# /etc/gitlab/initial_root_password inside the container (removed after 24h).
GITLAB_ROOT_PASSWORD=

# Runner authentication token from the GitLab UI (starts with glrt-).
# Required. The runner container exits if this is empty.
# Create a runner after GitLab is up, then set the token and start the runner.
RUNNER_TOKEN=

# URL the runner uses to reach GitLab. Default matches docker-compose.yml.
GITLAB_URL=http://gitlab.local
