# Example only. setup_runner.sh rewrites /etc/gitlab-runner/config.toml
# on every container start from RUNNER_TOKEN and GITLAB_URL.
# The generated file is gitignored. Do not put a real token in this file.

[[runners]]
  name = "git_runner"
  url = "http://gitlab.local"
  token = "${RUNNER_TOKEN}"
  executor = "docker"
  [runners.custom_build_dir]
  [runners.docker]
    tls_verify = false
    image = "docker:latest"
    privileged = true
    disable_entrypoint_overwrite = false
    volumes = ["/var/run/docker.sock:/var/run/docker.sock"]
    networks = ["gitlab-network"]
    network_mode = "host"
    extra_hosts = ["gitlab.local:172.18.0.2"]
  [runners.cache]
    [runners.cache.s3]
    [runners.cache.gcs]
    tag_list = ["ci-cd", "order-tracker"]
